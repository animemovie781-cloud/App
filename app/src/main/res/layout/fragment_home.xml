<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/z_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/onboarding_logo_mark" android:contentDescription="Zangetsu logo" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="ZANGETSU" android:textColor="@color/z_text_primary" android:textStyle="bold" android:textSize="17sp" android:letterSpacing="0.12" />
            <TextView android:id="@+id/profileButton" android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:text="◉" android:textColor="@color/z_text_primary" android:textSize="22sp" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="440dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_dock">
            <ImageView android:id="@+id/heroArtwork" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/onboarding_logo_mark" android:alpha="0.28" />
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_hero_scrim" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:padding="22dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FEATURED" android:textColor="@color/z_accent" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.18" />
                <TextView android:id="@+id/heroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Discover your next story" android:textColor="@color/z_text_primary" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:id="@+id/heroMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Anime  •  Movies  •  Series  •  Manga" android:textColor="@color/z_text_secondary" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp" android:orientation="horizontal">
                    <Button android:id="@+id/heroPlay" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="▶  Explore" android:textAllCaps="false" />
                    <Button android:id="@+id/heroInfo" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="10dp" android:text="ⓘ  Details" android:textAllCaps="false" android:backgroundTint="@color/z_surface_2" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="26dp" android:text="Continue watching" android:textColor="@color/z_text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="6dp" android:text="Your recently watched titles will appear here" android:textColor="@color/z_text_secondary" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="24dp" android:text="Trending now" android:textColor="@color/z_text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="6dp" android:text="Connect a catalogue source to load trending titles" android:textColor="@color/z_text_secondary" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>