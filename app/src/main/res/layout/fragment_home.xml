<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/z_bg">
    <ScrollView android:id="@+id/homeScroll" android:layout_width="match_parent"
        android:layout_height="match_parent" android:clipToPadding="false"
        android:fillViewport="false" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="100dp">
            <FrameLayout android:id="@+id/heroSection" android:layout_width="match_parent" android:layout_height="560dp">
                <androidx.viewpager2.widget.ViewPager2 android:id="@+id/heroPager"
                    android:layout_width="match_parent" android:layout_height="match_parent"/>
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_home_hero_scrim"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:layout_gravity="top" android:layout_marginTop="32dp">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/onboarding_logo_mark" android:contentDescription="Zangetsu"/>
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                    <ImageView android:id="@+id/actionDownloads" style="@style/HomeHeaderAction" android:src="@drawable/ic_home_download" android:contentDescription="Downloads"/>
                    <ImageView android:id="@+id/actionNotifications" style="@style/HomeHeaderAction" android:src="@drawable/ic_home_bell" android:contentDescription="Notifications"/>
                    <ImageView android:id="@+id/actionSearch" style="@style/HomeHeaderAction" android:src="@drawable/ic_home_search" android:contentDescription="Search"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal"
                    android:layout_gravity="bottom" android:paddingStart="28dp"
                    android:paddingEnd="28dp" android:paddingBottom="24dp">
                    <TextView android:id="@+id/heroTitle" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:gravity="center"
                        android:text="Connect a source to discover anime"
                        android:textColor="@color/z_text_primary" android:textSize="25sp"
                        android:textStyle="bold" android:includeFontPadding="false"/>
                    <TextView android:id="@+id/heroMeta" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="14dp"
                        android:gravity="center" android:text="ANIME  ·  MOVIES  ·  SERIES"
                        android:textColor="#D0FFFFFF" android:textSize="11sp" android:letterSpacing="0.22"/>
                    <TextView android:id="@+id/heroDetails" android:layout_width="wrap_content"
                        android:layout_height="52dp" android:layout_marginTop="26dp"
                        android:gravity="center" android:paddingStart="44dp" android:paddingEnd="44dp"
                        android:background="@drawable/bg_home_details_button" android:text="View Details"
                        android:textColor="#FF0B0B0F" android:textSize="16sp" android:textStyle="bold"/>
                    <LinearLayout android:id="@+id/heroDots" android:layout_width="wrap_content"
                        android:layout_height="18dp" android:layout_marginTop="18dp"
                        android:gravity="center" android:orientation="horizontal"/>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
                <FrameLayout android:id="@+id/scheduleCard" android:layout_width="0dp"
                    android:layout_height="52dp" android:layout_weight="1" android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_home_shortcut" android:clipToOutline="true">
                    <ImageView android:id="@+id/scheduleArt" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:scaleType="centerCrop"/>
                    <View android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="#B3081428"/>
                    <TextView style="@style/HomeShortcutText" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:gravity="center"
                        android:drawableStart="@drawable/ic_home_calendar" android:drawablePadding="9dp"
                        android:text="Schedule &amp; lists"/>
                </FrameLayout>
                <FrameLayout android:id="@+id/genresCard" android:layout_width="0dp"
                    android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="10dp"
                    android:background="@drawable/bg_home_shortcut" android:clipToOutline="true">
                    <ImageView android:id="@+id/genresArt" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:scaleType="centerCrop"/>
                    <View android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="#B8A10B45"/>
                    <TextView style="@style/HomeShortcutText" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:gravity="center"
                        android:drawableStart="@drawable/ic_home_tag" android:drawablePadding="9dp"
                        android:text="Genres"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="28dp" android:paddingEnd="28dp" android:layout_marginTop="54dp">
                <TextView android:id="@+id/recentHeading" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Recently released" android:textColor="@color/z_text_primary"
                    android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:id="@+id/recentSeeAll" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="See All"
                    android:textColor="@color/z_accent" android:textSize="14sp"/>
            </LinearLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:scrollbars="none" android:clipToPadding="false">
                <LinearLayout android:id="@+id/recentPosters" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:paddingStart="28dp" android:paddingEnd="18dp"/>
            </HorizontalScrollView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="28dp" android:layout_marginTop="34dp"
                android:text="Popular this week" android:textColor="@color/z_text_primary"
                android:textSize="20sp" android:textStyle="bold"/>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/popularPosters" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:paddingStart="28dp" android:paddingEnd="18dp"/>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>
</FrameLayout>